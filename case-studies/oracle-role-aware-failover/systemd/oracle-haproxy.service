[Unit]
Description=Oracle Role-Aware HAProxy
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
RuntimeDirectory=oracle-router
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/haproxy -c -q -f /opt/oracle-router/haproxy.cfg
ExecStart=/usr/sbin/haproxy -Ws -f /opt/oracle-router/haproxy.cfg -p /run/oracle-router/haproxy.pid
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
